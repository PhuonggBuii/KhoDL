# Mau bien moi truong cho docker-compose.yml.
# Copy thanh ".env" va dien gia tri thuc (random) truoc khi chay "docker compose up".
# KHONG dien mat khau thuc vao file nay (file nay DUOC commit).

# Postgres nguon (source)
PG_SOURCE_DB=retail_source
PG_SOURCE_USER=source_user
PG_SOURCE_PASSWORD=change_me
PG_SOURCE_PORT=5432

# Postgres Data Warehouse
PG_DW_DB=retail_dw
PG_DW_USER=dw_user
PG_DW_PASSWORD=change_me
PG_DW_PORT=5433

# Postgres metadata cho Airflow (khong expose ra host)
PG_AIRFLOW_DB=airflow_meta
PG_AIRFLOW_USER=airflow_user
PG_AIRFLOW_PASSWORD=change_me

# Airflow — FERNET_KEY: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_SECRET_KEY=change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_WEBSERVER_PORT=8081

# FastAPI
FASTAPI_PORT=8000

# Superset
SUPERSET_SECRET_KEY=change_me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_PORT=8088
